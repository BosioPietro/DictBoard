<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- The card. It floats over whatever app the word came from, and
             leaves no task of its own behind. -->
        <activity
            android:name=".DefineActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DictBoard.Card"
            android:windowSoftInputMode="adjustResize">

            <!-- "Define" in the menu of selected text, in any app, with any
                 keyboard. A keyboard can start it the same way, explicitly. -->
            <intent-filter android:label="@string/define">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Text shared to it. -->
            <intent-filter android:label="@string/define">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- From the launcher: the box to type a word in. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
